# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# 作品を構成する素材だけを明示的に追跡する。
# 全部追跡にすると、作業中の未加工音源などを git add . で履歴に焼き込む事故が起きる
# （バイナリは後から消してもヒストリからは消えない）
public/audio/*
!public/audio/.gitkeep
!public/audio/maou_14_shining_star.mp3
public/lyrics/*.json
!public/lyrics/sample.json
!public/lyrics/shining-star.json

# 書体も同じ扱い（M8-2a）。font-preview.html で見比べるあいだ、選ばれなかった候補の
# woff2 が public/fonts/ に並ぶので、作品に入れた 1 つだけを名指しで追跡する。
# ライセンス（OFL）は再配布する woff2 に必ず付ける必要があるので一緒に追跡する
public/fonts/*
!public/fonts/zen-kaku-gothic-new.woff2
!public/fonts/zen-kaku-gothic-new.charset.txt
!public/fonts/zen-kaku-gothic-new.LICENSE.txt

# サブセット化の元にした素の ttf（数 MB ある）。tools/subset-font.mjs の入力で、
# 出力（public/fonts/*.woff2）さえあれば公開には要らない
/.fonts-src/

# 歌詞の下書き。public/ に置くと Pages にそのまま公開されてしまうのでリポジトリ直下に置く
/ss.txt

# Vite は VITE_ 接頭辞の変数をバンドルに埋め込んで公開するため、誤コミットは即露出する
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
